# Copy this file to .env and replace both example passwords before deployment.
# Values below are examples and match the standard low-memory deployment.

# Host UDP port for ordinary syslog and optional Shelly debug output (example: 514).
# A bind address is supported, for example 192.168.1.10:514.
SYSLOG_UDP_PORT=514
# Host TCP port for RFC3164/RFC5424 syslog (example: 514).
SYSLOG_TCP_PORT=514
# Host HTTP port for LogAnalyzer (example: 8181); no login is enabled by default.
LOGANALYZER_PORT=8181

# MariaDB root password, used only when initializing a new database volume.
# Generate a unique value with: openssl rand -hex 32
DB_ROOT_PASSWORD=replace-with-a-generated-root-password
# Application account created in a new database (example: syslog).
DB_USER=syslog
# Application password shared by syslog-ng, LogAnalyzer and dbcleanup.
# Generate a separate value with: openssl rand -hex 32
# Changing passwords here does not update accounts in an existing volume.
DB_PASSWORD=replace-with-a-generated-application-password
# Database initialized in a new volume (example: syslogdb).
DB_NAME=syslogdb

# Delete messages whose ReceivedAt is older than this many days (example: 7).
# Must be a positive integer; existing local retention settings take precedence.
LOG_RETENTION_DAYS=7
# Cleanup schedule in TZ, five cron fields without a user field (example: daily 08:45).
DBCLEANUP_CRON="45 8 * * *"
# Maximum rows per deletion transaction, 1..10000 (example: 1000).
DBCLEANUP_BATCH_SIZE=1000
# Seconds to pause between full deletion batches, >= 0 (example: 0.1).
DBCLEANUP_BATCH_PAUSE=0.1

# InnoDB buffer pool; not a limit on total MariaDB RAM (example: 256M).
DB_BUFFER_POOL_SIZE=256M
# Commit durability: 1 = durable; 2 can lose recent commits on power/OS failure.
# Keep 1 unless that durability tradeoff is acceptable (example: 1).
DB_FLUSH_AT_COMMIT=1

# Check optional diagnostic files for rotation in TZ (example: hourly).
# Keep cron values quoted; files live in a temporary 32 MiB RAM directory.
LOGROTATE_CRON="0 * * * *"
# Rotate files above this size when checked (example: 2M; not a hard size limit).
LOGROTATE_SIZE=2M
# Remove rotated files older than this many days when rotating (example: 30).
LOGROTATE_MAX_AGE_DAYS=30
# Number of rotated files retained per log (example: 2).
LOGROTATE_ROTATIONS=2

# IANA timezone for containers, timestamps and cron schedules (example: Europe/Berlin).
TZ=Europe/Berlin
