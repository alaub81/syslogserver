# Exposed application ports
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
LOGANALYZER_PORT=8181

# Logrotate in syslog-ng
LOGROTATE_CRON="0 * * * *"     # hourly (keep the quotes)
LOGROTATE_SIZE="2M"            # small rotation threshold for the 32 MiB log tmpfs
LOGROTATE_MAX_AGE_DAYS="30"    # delete rotated files older then x days
LOGROTATE_ROTATIONS="2"        # keep two rotated files per log

# Database Root Password
DB_ROOT_PASSWORD=supersecurepassword
# Database syslog user
DB_USER=syslog
# Database syslog user password
DB_PASSWORD=syslogpass
# Database syslog db name
DB_NAME=syslogdbnew
# Delete Database entries older then:
LOG_RETENTION_DAYS=7
# Cleanup-Cronjob
DBCLEANUP_CRON="45 8 * * *"
# Small transactions with a pause between full batches (no routine OPTIMIZE).
DBCLEANUP_BATCH_SIZE=1000
DBCLEANUP_BATCH_PAUSE=0.1

# Standard MariaDB tuning (64-bit Pi, >= 2 GiB RAM).
DB_BUFFER_POOL_SIZE=256M
# 1 = durable commits; 2 = fewer syncs, possible loss after OS/power failure.
DB_FLUSH_AT_COMMIT=1

# Timezone
TZ=Europe/Berlin
