{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 1"],
  "labels": ["dependencies"],
  "automerge": false,
  "vulnerabilityAlerts": { "enabled": false },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/.lint-venv/**",
    "**/.lint-tools/**",
    ".local/**"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python lint tools"
    },
    {
      "matchDatasources": ["docker"],
      "groupName": null
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^resources/loganalyzer/Dockerfile$/"],
      "matchStrings": [
        "LOGANALYZER_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "rsyslog/loganalyzer",
      "versioningTemplate": "semver"
    }
  ]
}
