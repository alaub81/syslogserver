{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint:all",
      "type": "process",
      "command": "${workspaceFolder}/tests/linter-check.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "compose:dev:up",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "${workspaceFolder}/docker-compose.dev.yml",
        "up",
        "-d",
        "--build",
        "--wait"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
